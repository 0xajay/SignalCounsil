# SignalCouncil Backend Environment Configuration
# For local testing, copy this file to .env:
# cp .env.example .env

# Gemini API Key (Required for AI synthesis & chart review)
# In Cloud Run: Mount from Secret Manager (e.g. --set-secrets=GEMINI_API_KEY=signal-gemini-key:latest)
GEMINI_API_KEY=your_gemini_api_key_here

# Server Port (In Cloud Run, automatically supplied as $PORT, default 8080)
PORT=8080

# Server Host
HOST=0.0.0.0

# Environment Mode: development | staging | production
ENVIRONMENT=production

# CORS Allowed Origins (Comma-separated origins, or * to allow all including extension origins)
# For production extensions, chrome-extension://<EXTENSION_ID> can be added, or '*' for public API.
CORS_ORIGINS=*

# Logging Level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Default Gemini Flash Model
DEFAULT_GEMINI_MODEL=gemini-2.5-flash
