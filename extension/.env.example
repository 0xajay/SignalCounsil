# SignalCouncil Extension Environment Configuration
# Copy this file to .env before building if you want a custom default backend URL:
# cp .env.example .env

# Backend API Base URL
# For local development: http://localhost:8080
# For Cloud Run production: https://signal-council-api-xxxxxxxxxx-uc.a.run.app
VITE_API_URL=https://<your-cloud-run-service>.a.run.app
